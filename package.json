{
  "name": "transporte-tomasini",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "npm run start --workspace @tomasini/backend"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
