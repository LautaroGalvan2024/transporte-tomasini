{
  "name": "@tomasini/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.test --import tsx --test --test-concurrency=1 tests/integration.test.ts tests/invitations.test.ts tests/transaction.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/bootstrap-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "notifications:run": "tsx scripts/run-notifications.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "10.3.1",
    "pg": "^8.16.3",
    "zod": "^4.1.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
